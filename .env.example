# Required production configuration. Do not commit real values.
STORIES_DB_PATH=/var/lib/stories/stories.sqlite3
GOOGLE_CLIENT_ID=replace-with-google-oauth-web-client-id
GOOGLE_ALLOWED_EMAIL=replace-with-authorized-email
GOOGLE_ALLOWED_SUB=replace-with-immutable-google-subject
SESSION_SECRET=replace-with-at-least-32-random-characters
PUBLIC_ORIGIN=https://stories.example.com
SESSION_MAX_AGE_SECONDS=3600

# Optional summarization provider settings.
STORY_GIST_PROVIDER=openai-codex
STORY_GIST_MODEL=gpt-5.6-luna
STORY_GIST_COMMAND="python3 /home/david/.hermes/work/stories-dashboard/scripts/hermes_gist_command.py"

# Configured separately in /srv/stories-dashboard/phase2.env by configure_phase2_webhook.py
# HERMES_WEBHOOK_URL=http://127.0.0.1:8644/webhooks/stories-phase2
# HERMES_WEBHOOK_SECRET=<generated signing secret>
