    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "publisher": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "published_at": {
            "type": "string",
            "maxLength": 12000
          },
          "accessed_at": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "locator": {
            "type": "string",
            "maxLength": 12000
          }
        },
        "required": [
          "id",
          "title",
          "url",
          "publisher",
          "published_at",
          "accessed_at",
          "locator"
