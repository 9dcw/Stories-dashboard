        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "text": {
            "type": "string",
            "maxLength": 12000
          },
          "label": {
            "enum": [
              "Verified",
              "Reported",
              "Alleged",
              "Inference",
              "Unverified"
            ]
          },
          "source_ids": {
            "type": "array",
