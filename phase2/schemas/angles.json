        "additionalProperties": false
      },
      "maxItems": 100
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 12000
      },
      "maxItems": 100
    },
    "angles": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
