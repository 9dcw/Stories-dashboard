{
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "maxLength": 12000
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "text": {
            "type": "string",
            "maxLength": 12000
          }
        },
        "required": [
          "heading",
          "text"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "publisher": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "published_at": {
            "type": "string",
            "maxLength": 12000
          },
          "accessed_at": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "locator": {
            "type": "string",
            "maxLength": 12000
          }
        },
        "required": [
          "id",
          "title",
          "url",
          "publisher",
          "published_at",
          "accessed_at",
          "locator"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "text": {
            "type": "string",
            "maxLength": 12000
          },
          "label": {
            "enum": [
              "Verified",
              "Reported",
              "Alleged",
              "Inference",
              "Unverified"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "maxItems": 100
          },
          "disposition": {
            "type": "string",
            "maxLength": 12000
          },
          "limitations": {
            "type": "string",
            "maxLength": 12000
          }
        },
        "required": [
          "id",
          "text",
          "label",
          "source_ids",
          "disposition",
          "limitations"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 12000
      },
      "maxItems": 100
    },
    "investigations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 12000
          },
          "priority": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "source_targets": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 12000
            },
            "maxItems": 100
          },
          "narrative_purpose": {
            "type": "string",
            "maxLength": 12000
          },
          "visual_requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 12000
            },
            "maxItems": 100
          }
        },
        "required": [
          "question",
          "priority",
          "source_targets",
          "narrative_purpose",
          "visual_requirements"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "summary",
    "sections",
    "sources",
    "claims",
    "gaps",
    "investigations"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "plan v1"
}
